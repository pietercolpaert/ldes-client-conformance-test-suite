{
  "protocolVersion": 0,
  "id": "europeana",
  "name": "LDES conformance adapter for Europeana",
  "revision": "1",
  "client": {
    "id": "europeana-rd-ldes-client",
    "name": "europeana/rd-ldes-client",
    "homepage": "https://github.com/europeana/rd-ldes-client",
    "version": "0.1-SNAPSHOT",
    "revision": "main"
  },
  "command": [
    "node",
    "adapters/europeana/adapter.mjs"
  ],
  "timeoutMs": 45000,
  "capabilities": {
    "modes": [
      "ordered",
      "unordered"
    ],
    "memberExtraction": true,
    "context": false,
    "persistentState": true
  }
}

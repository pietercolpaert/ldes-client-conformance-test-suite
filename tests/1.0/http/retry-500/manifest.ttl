@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#http-retry-500> a earl:TestCase;
    dct:title "500 Internal Server Error is retried with back-off in unordered mode";
    dct:description "The root node returns 500 Internal Server Error twice before a valid representation. The client must retry rather than treat the status as terminal data loss, and every member must still be emitted. The request timeline asserts only that consecutive attempts are spaced, so any back-off strategy, retry count or jitter satisfies it.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-041>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal .

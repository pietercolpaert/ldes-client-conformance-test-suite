@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#http-retryable-statuses> a earl:TestCase;
    dct:title "Every required transient HTTP status is retried";
    dct:description "The server returns each retryable status once before a valid root representation.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-038>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-039>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-040>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-041>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-042>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-043>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-044>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal .

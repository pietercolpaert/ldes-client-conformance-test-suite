@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-shacl-inverse-path> a earl:TestCase;
    dct:title "Ordered traversal evaluates an inverse SHACL path";
    dct:description "The ordering value is reached through sh:inversePath; member IRIs are adversarial to expose fallback ordering.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-007>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-global-order> a earl:TestCase;
    dct:title "Ordered traversal emits a global ascending sequence and finalizes equal-value transactions last";
    dct:description "Fetch order is deliberately different from member order and relation targets contain competing bounds.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-001>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-005>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-008>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-016>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

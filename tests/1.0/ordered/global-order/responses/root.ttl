@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<{{raw}}responses/root.ttl#ordered-stream> tree:view <>;
    ldes:sequencePath ex:sequence;
    ldes:transactionFinalizedPath ex:done;
    tree:member
        <{{raw}}responses/root.ttl#member/three>,
        <{{raw}}responses/root.ttl#member/two-final>,
        <{{raw}}responses/root.ttl#member/two> .

<> tree:relation [
    a tree:LessThanOrEqualToRelation;
    tree:path ex:sequence;
    tree:value 1;
    tree:node <earlier>
] .

<{{raw}}responses/root.ttl#member/three> ex:sequence 3; ex:value "three" .
<{{raw}}responses/root.ttl#member/two-final> ex:sequence 2; ex:done true; ex:value "two final" .
<{{raw}}responses/root.ttl#member/two> ex:sequence 2; ex:value "two" .

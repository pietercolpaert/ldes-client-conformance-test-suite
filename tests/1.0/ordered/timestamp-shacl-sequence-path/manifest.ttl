@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-timestamp-shacl-sequence-path> a earl:TestCase;
    dct:title "Ordered traversal evaluates a SHACL sequence timestamp path";
    dct:description "The timestamp is reached through a multi-step SHACL property path, and member IRIs are deliberately ordered opposite to chronology.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-007>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-010>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

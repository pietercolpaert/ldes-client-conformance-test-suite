@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    ldes:sequencePath ex:sequence;
    tree:member <{{raw}}responses/root.ttl#member/2> .
<> tree:relation [
    a tree:LessThanRelation;
    tree:path ex:sequence;
    tree:value 2;
    tree:node <low>
], [
    a tree:GreaterThanOrEqualToRelation;
    tree:path ex:sequence;
    tree:value 1;
    tree:node <low>
], [
    a tree:GreaterThanRelation;
    tree:path ex:sequence;
    tree:value 2;
    tree:node <high>
] .
<{{raw}}responses/root.ttl#member/2> ex:sequence 2; ex:value "two" .

@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
<https://www.pieter.pm/ldes-client-conformance-test-suite/1.0#ordered-typed-numeric-order> a earl:TestCase;
    dct:title "exact integer and decimal order";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

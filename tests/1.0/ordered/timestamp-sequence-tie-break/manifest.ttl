@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-timestamp-sequence-tie-break> a earl:TestCase;
    dct:title "Ordered traversal uses ldes:sequencePath as timestamp tie-breaker";
    dct:description "When both timestamp and sequence paths are present, timestamp determines chronological order and sequence orders equal-timestamp members.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-001>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-010>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

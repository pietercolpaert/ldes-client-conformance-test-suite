@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    ldes:timestampPath ex:time;
    ldes:sequencePath ex:sequence;
    tree:member
        <{{raw}}responses/root.ttl#member/later-zero>,
        <{{raw}}responses/root.ttl#member/a-early-two>,
        <{{raw}}responses/root.ttl#member/z-early-one> .

<{{raw}}responses/root.ttl#member/later-zero> ex:time "2026-01-01T00:00:02Z"^^xsd:dateTime; ex:sequence 0; ex:value "later zero" .
<{{raw}}responses/root.ttl#member/a-early-two> ex:time "2026-01-01T00:00:01Z"^^xsd:dateTime; ex:sequence 2; ex:value "early two" .
<{{raw}}responses/root.ttl#member/z-early-one> ex:time "2026-01-01T00:00:01Z"^^xsd:dateTime; ex:sequence 1; ex:value "early one" .

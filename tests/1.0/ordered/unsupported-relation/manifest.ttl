@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-unsupported-relation> a earl:TestCase;
    dct:title "Unknown TREE relation types are handled conservatively";
    dct:description "An unknown relation type must not cause silent member loss.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-010>;
    ct:requirementLevel ct:Should;
    ct:group ct:OrderedTraversal .

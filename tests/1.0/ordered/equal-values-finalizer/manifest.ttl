@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-equal-values-finalizer> a earl:TestCase;
    dct:title "Transaction-finalizing member is emitted last for equal order values";
    dct:description "Members with the same ordering value are emitted with the finalizing member last.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-016>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

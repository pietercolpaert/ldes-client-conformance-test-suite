@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    ldes:sequencePath ex:sequence;
    ldes:transactionFinalizedPath ex:done;
    tree:member <{{raw}}responses/root.ttl#member/2-final>, <{{raw}}responses/root.ttl#member/2-a> .

<{{raw}}responses/root.ttl#member/2-final> ex:sequence 2; ex:done true; ex:value "two final" .
<{{raw}}responses/root.ttl#member/2-a> ex:sequence 2; ex:value "two a" .

@prefix ex: <https://example.test/vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .
<https://example.test/path-stream> tree:view <>;
    ldes:sequencePath ( ex:metadata ex:sequence );
    tree:member <https://example.test/member/path-two>, <https://example.test/member/path-one> .
<https://example.test/member/path-two> ex:metadata [ ex:sequence 2 ]; ex:value "two" .
<https://example.test/member/path-one> ex:metadata [ ex:sequence 1 ]; ex:value "one" .

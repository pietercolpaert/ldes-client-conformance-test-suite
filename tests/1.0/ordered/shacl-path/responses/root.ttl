@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .
<{{raw}}responses/root.ttl#path-stream> tree:view <>;
    ldes:sequencePath ( ex:metadata ex:sequence );
    tree:member <{{raw}}responses/root.ttl#member/path-two>, <{{raw}}responses/root.ttl#member/path-one> .
<{{raw}}responses/root.ttl#member/path-two> ex:metadata [ ex:sequence 2 ]; ex:value "two" .
<{{raw}}responses/root.ttl#member/path-one> ex:metadata [ ex:sequence 1 ]; ex:value "one" .

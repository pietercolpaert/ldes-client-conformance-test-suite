@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-shacl-alternative-path> a earl:TestCase;
    dct:title "Ordered traversal evaluates sh:alternativePath";
    dct:description "The LDES ordering path may be a SHACL alternative path rather than a direct predicate or sequence path.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-ORD-007>;
    ct:requirementLevel ct:Must;
    ct:group ct:OrderedTraversal .

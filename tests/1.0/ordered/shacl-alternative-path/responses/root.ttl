@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    ldes:sequencePath [ sh:alternativePath ( ex:primarySequence ex:fallbackSequence ) ];
    tree:member
        <{{raw}}responses/root.ttl#member/two>,
        <{{raw}}responses/root.ttl#member/one> .

<{{raw}}responses/root.ttl#member/two> ex:primarySequence 2; ex:value "two" .
<{{raw}}responses/root.ttl#member/one> ex:fallbackSequence 1; ex:value "one" .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-common-generic-extraction> a earl:TestCase;
    dct:title "Generic member extraction in ordered mode";
    dct:description "The member extraction algorithm is not mode-specific, so the comprehensive generic-extraction case is also exercised in ordered mode: focus-node discovery scoped to the event stream, the default-graph subject star, all quads in the graph named by the member IRI, recursive blank nodes with cycle protection, and no emission of unrelated subjects or other streams' members. LDES 1.0 permits a client that implements ordered mode only, and this fixture lets such a client demonstrate the mandatory extraction obligations. The stream carries ordering metadata and the second member's IRI sorts before the first, so an ID fallback cannot satisfy the oracle.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-002>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-003>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-005>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-007>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-008>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

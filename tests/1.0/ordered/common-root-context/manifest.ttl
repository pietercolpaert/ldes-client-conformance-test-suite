@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#ordered-common-root-context> a earl:TestCase;
    dct:title "Root context is communicated in ordered mode";
    dct:description "Root-node context extraction and communication is not mode-specific, so the comprehensive root-context case is also exercised in ordered mode. LDES 1.0 permits a client that implements ordered mode only, and this fixture lets such a client demonstrate the mandatory context obligations rather than reporting them as inapplicable.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-001>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-002>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-003>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-005>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-007>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-008>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-009>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-RET-003>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-RET-004>;
    ct:requirementLevel ct:Must;
    ct:group ct:ContextInformation .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#context-polling-interval> a earl:TestCase;
    dct:title "Polling interval is communicated as advisory context";
    dct:description "The client reports ldes:pollingInterval when the adapter exposes context information.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-003>;
    ct:requirementLevel ct:Should;
    ct:group ct:ContextInformation .

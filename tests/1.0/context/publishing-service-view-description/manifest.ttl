@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#context-publishing-service-view-description> a earl:TestCase;
    dct:title "Publishing-service context through view description is communicated";
    dct:description "The root links to a view description containing service metadata.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-009>;
    ct:requirementLevel ct:Must;
    ct:group ct:ContextInformation .

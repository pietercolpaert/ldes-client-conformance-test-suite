@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#context-retention-policy-view-description> a earl:TestCase;
    dct:title "View-description retention policy is extracted as context";
    dct:description "A retention policy linked from tree:viewDescription is communicated without requiring interpretation.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-RET-004>;
    ct:requirementLevel ct:Must;
    ct:group ct:ContextInformation .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#context-root-and-eventstream-iri> a earl:TestCase;
    dct:title "Root and event stream IRIs are communicated";
    dct:description "The context event identifies both the discovered event stream and root node.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-CTX-001>;
    ct:requirementLevel ct:Must;
    ct:group ct:ContextInformation .

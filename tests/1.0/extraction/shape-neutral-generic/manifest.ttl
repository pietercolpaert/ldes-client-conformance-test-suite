@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-shape-neutral-generic> a earl:TestCase;
    dct:title "Shape metadata does not frame generic member extraction";
    dct:description "On an ordinary Turtle response, tree:shape communicates validation context but does not suppress member triples outside that shape.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-002>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-005>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

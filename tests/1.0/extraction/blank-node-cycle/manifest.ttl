@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-blank-node-cycle> a earl:TestCase;
    dct:title "Blank-node extraction terminates on cycles";
    dct:description "The member payload contains a cyclic blank-node structure and must still produce finite output.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-006>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

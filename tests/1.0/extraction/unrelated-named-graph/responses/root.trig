@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    tree:member <{{raw}}responses/root.ttl#member/isolated> .

<{{raw}}responses/root.ttl#member/isolated> ex:value "default graph" .

<{{raw}}responses/root.ttl#member/isolated> {
    <{{raw}}responses/root.ttl#payload> ex:value "member graph" .
}

<{{raw}}responses/root.ttl#foreign-graph> {
    <{{raw}}responses/root.ttl#member/isolated> ex:poison "must not be extracted" .
}

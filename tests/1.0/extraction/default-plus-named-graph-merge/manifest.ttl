@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-default-plus-named-graph-merge> a earl:TestCase;
    dct:title "Default and member-named graph payloads are merged";
    dct:description "The member dataset is split between the default graph and graph named by the member IRI.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-003>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-004>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

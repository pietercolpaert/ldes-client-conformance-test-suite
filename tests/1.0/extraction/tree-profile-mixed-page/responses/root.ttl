@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    tree:member <{{raw}}responses/root.ttl#tree/member/mixed> .

<{{raw}}responses/root.ttl#tree/member/mixed> a ex:ProfileMember;
    ex:value "tree profile mixed" .
<{{raw}}responses/root.ttl#unrelated-resource> a ex:ProfileMember;
    ex:value "not a member" .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-tree-profile-shape-targets> a earl:TestCase;
    dct:title "TREE Profile extraction with shape metadata";
    dct:description "A TREE Profile-capable client preserves member data while shape metadata is present on the stream.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-001>;
    ct:requirementLevel ct:May;
    ct:group ct:MemberExtraction;
    ct:requiresCapability ct:TreeProfileExtraction .

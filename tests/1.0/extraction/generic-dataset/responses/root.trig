@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#extraction-stream> tree:view <>;
    tree:member <{{raw}}responses/root.ttl#member/complex> .

<{{raw}}responses/root.ttl#other-stream>
    tree:member <{{raw}}responses/root.ttl#member/not-ours> .

<{{raw}}responses/root.ttl#member/complex>
    ex:value "default";
    ex:detail _:a .
_:a ex:next _:b .
_:b ex:next _:a; ex:value "nested" .

<{{raw}}responses/root.ttl#unrelated> ex:value "must not be emitted" .
<{{raw}}responses/root.ttl#member/not-ours> ex:value "wrong stream" .

<{{raw}}responses/root.ttl#member/complex> {
  <{{raw}}responses/root.ttl#member/complex> ex:value "named graph" .
  <{{raw}}responses/root.ttl#payload-part> ex:value "all quads in the member graph" .
}

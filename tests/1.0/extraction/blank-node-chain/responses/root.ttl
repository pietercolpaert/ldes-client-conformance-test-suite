@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> tree:view <>;
    tree:member <{{raw}}responses/root.ttl#member/blank-chain> .

<{{raw}}responses/root.ttl#member/blank-chain> ex:detail [
    ex:level "one";
    ex:next [
      ex:level "two"
    ]
] .

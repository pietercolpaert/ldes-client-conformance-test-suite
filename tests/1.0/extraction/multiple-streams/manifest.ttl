@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-multiple-streams> a earl:TestCase;
    dct:title "Member extraction is scoped to the discovered event stream";
    dct:description "A page contains members for two streams; only the selected stream may be emitted.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-004>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

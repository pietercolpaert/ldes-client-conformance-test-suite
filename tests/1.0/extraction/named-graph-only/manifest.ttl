@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#extraction-named-graph-only> a earl:TestCase;
    dct:title "Member-named graph extraction without default graph data";
    dct:description "The member payload exists only in the graph named by the member IRI.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-004>;
    ct:requirementLevel ct:Must;
    ct:group ct:MemberExtraction .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#unordered-mutable-sync> a earl:TestCase;
    dct:title "A later synchronization run emits only newly discovered members";
    dct:description "The same client state is reused for a second synchronization run after the server adds a frontier member; the client must not re-emit the old member and must emit the new one.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-018>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-019>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-024>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-025>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-026>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal;
    ct:scenario <scenario.yaml>;
    ct:expected <expected/events.ndjson> .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#unordered-rdf-immutable> a earl:TestCase;
    dct:title "RDF ldes:immutable prevents a second node fetch";
    dct:description "The node is immutable only through RDF metadata, without a Cache-Control immutable directive.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-020>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-021>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-023>;
    ct:requirementLevel ct:Should;
    ct:group ct:UnorderedTraversal .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#unordered-polling-interval-scheduling> a earl:TestCase;
    dct:title "Advertised polling interval controls synchronization";
    dct:description "A follow-mode client observes ldes:pollingInterval in seconds instead of using a faster implementation default.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-005>;
    ct:requirementLevel ct:Should;
    ct:group ct:UnorderedTraversal;
    ct:requiresCapability ct:Polling .

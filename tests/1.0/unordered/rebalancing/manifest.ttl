@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#unordered-rebalancing> a earl:TestCase;
    dct:title "Redirected and gone pages do not cause loss or duplicate emission during rebalancing";
    dct:description "The server first publishes one member, then rebalances the page through redirect and 410 Gone responses; the client must retain state, avoid duplicate emission, and still discover the new member.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-019>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-036>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-046>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal;
    ct:scenario <scenario.yaml>;
    ct:expected <expected/events.ndjson> .

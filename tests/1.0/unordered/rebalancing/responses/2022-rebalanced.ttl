@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#rebalanced-stream> a ldes:EventStream;
    tree:view <../root>;
    tree:member <{{raw}}responses/root.ttl#member/old>, <{{raw}}responses/root.ttl#member/new> .

<> ldes:immutable true .

<{{raw}}responses/root.ttl#member/old> a ex:Event;
    ex:value "old" .

<{{raw}}responses/root.ttl#member/new> a ex:Event;
    ex:value "new" .

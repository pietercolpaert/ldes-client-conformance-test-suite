@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#discovery-current-page-precedence> a earl:TestCase;
    dct:title "The current-page tree:view match takes precedence over fallback metadata";
    dct:description "The entry point redirects, and the target page carries both a current-page tree:view pattern and a tree:view statement about the originally supplied IRI that points at a decoy root. The client must resolve the relative view and relation IRIs against the post-redirect base, select the current-page match, and never dereference the decoy. The fallback lookup is only consulted when the current-page pattern is absent.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-011>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-013>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-036>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal .

@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#discovery-ambiguous-view> a earl:TestCase;
    dct:title "Multiple current-page tree:view matches are rejected";
    dct:description "The entry representation contains more than one current-page tree:view match, which the initialization algorithm requires the client to report as an error.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-012>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal .

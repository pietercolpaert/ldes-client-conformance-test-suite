@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#discovery-ambiguous-view> a earl:TestCase;
    dct:title "Multiple current-page tree:view matches are handled without an invalid traversal";
    dct:description "The entry representation contains more than one current-page tree:view match. A client may report the ambiguity or apply a deterministic fallback such as selecting the first encountered view, but it must not hang or produce malformed protocol output.";
    dct:isPartOf <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-012>;
    ct:requirementLevel ct:Should;
    ct:group ct:UnorderedTraversal .

@prefix ex: <{{raw}}responses/root.ttl#vocab/> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix tree: <https://w3id.org/tree#> .

<{{raw}}responses/root.ttl#stream> a ldes:EventStream;
    tree:view <>;
    tree:member <{{raw}}responses/root.ttl#member/1> .

<{{raw}}responses/root.ttl#member/1> a ex:Event;
    ex:value "one" .

<{{raw}}responses/root.ttl#unrelated>
    ex:value "must not be emitted as member data" .

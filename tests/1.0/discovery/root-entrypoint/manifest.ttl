@prefix ct: <https://w3id.org/ldes/conformance/vocab#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@base <https://www.pieter.pm/ldes-client-conformance-test-suite/1.0> .

<#discovery-root-entrypoint> a earl:TestCase;
    dct:title "A root-node IRI is accepted as the entry point";
    dct:description
        "The supplied IRI is both the fetched document and the sole tree:view target; the root member must be emitted.";
    dct:isPartOf
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-002>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-006>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-007>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-008>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-009>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-010>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-011>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-UNORD-017>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-002>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-003>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-004>,
        <https://w3id.org/ldes/conformance/requirements/LDES10-EXTRACT-005>;
    dct:source
        <https://semiceu.github.io/LinkedDataEventStreams/releases/1.0.0/#initialization-run>;
    ct:requirementLevel ct:Must;
    ct:group ct:UnorderedTraversal;
    ct:scenario <scenario.yaml>;
    ct:expected <expected/events.ndjson> .

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/ldes/conformance/schema/scenario.json",
  "title": "LDES conformance HTTP scenario",
  "type": "object",
  "required": ["version", "entrypoint"],
  "properties": {
    "version": { "const": 0 },
    "name": { "type": "string" },
    "entrypoint": { "type": "string", "pattern": "^/" },
    "requestBudget": { "type": "integer", "minimum": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["unordered", "ordered"] }
        },
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "routes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "routes": { "$ref": "#/$defs/routes" }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "$ref": "#/$defs/routes"
    }
  },
  "$defs": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "requests"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["response"],
              "properties": {
                "response": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "headers": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "body": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
